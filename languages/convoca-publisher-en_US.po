#. Plugin URI of the plugin
#. Author URI of the plugin
#: convoca-publisher.php
msgid "https://getconvoca.app"
msgstr "https://getconvoca.app"

#. Description of the plugin
#: convoca-publisher.php
msgid "Publish WordPress posts to social media channels with customizable templates."
msgstr "Publish WordPress posts to social media channels with customizable templates."

#. Author of the plugin
#: convoca-publisher.php
msgid "Jose Carlos Nieto Ramos"
msgstr "Jose Carlos Nieto Ramos"

#: convoca-publisher.php:53
msgid "Este plugin requiere el plugin"
msgstr "This plugin requires the"

#: convoca-publisher.php:54
msgid "Convoca Core"
msgstr "Convoca Core"

#: convoca-publisher.php:55
msgid "activo."
msgstr "plugin to be active."

#. translators: %1$s: minimum required PHP version, %2$s: current PHP version
#: convoca-publisher.php:85
#, php-format
msgid "Convoca Publisher requiere PHP %1$s o superior. Tu versión: %2$s"
msgstr "Convoca Publisher requires PHP %1$s or higher. Your version: %2$s"

#. translators: %s: minimum required WordPress version
#: convoca-publisher.php:97
#, php-format
msgid "Convoca Publisher requiere WordPress %s o superior."
msgstr "Convoca Publisher requires WordPress %s or higher."

#: convoca-publisher.php:132
msgid "🔐 Convoca Publisher — Aviso de privacidad"
msgstr "🔐 Convoca Publisher — Privacy notice"

#: convoca-publisher.php:133
msgid "Este plugin envía datos (título, extracto, URL, imagen destacada y etiquetas de tus entradas) a APIs de terceros (Meta, LinkedIn, Twitter/X, TikTok, Google, Telegram, Mastodon) cuando publicas contenido en redes sociales. Los tokens de acceso se almacenan cifrados en la base de datos de WordPress."
msgstr "This plugin sends data (title, excerpt, URL, featured image, and tags from your posts) to third-party APIs (Meta, LinkedIn, Twitter/X, TikTok, Google, Telegram, Mastodon) when you publish content to social networks. Access tokens are stored encrypted in the WordPress database."

#: convoca-publisher.php:134 includes/class-admin.php:565
msgid "He leído y acepto este aviso"
msgstr "I have read and accept this notice"

