{
    "name": "convoca/publisher",
    "description": "WordPress plugin for auto-publishing posts to social media. Part of the Convoca ecosystem. Supports Facebook, Instagram, LinkedIn, Twitter/X, TikTok, Google My Business, Telegram and Mastodon.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Jos\u00e9 Carlos Nieto Ramos",
            "homepage": "https://josecarlosnietoramos.wordpress.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-openssl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "php-stubs/wordpress-stubs": "^6.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpunit/phpunit": "^10.0",
        "yoast/phpunit-polyfills": "^3.0"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "scripts": {
        "test:stan": "php -d memory_limit=1G vendor/bin/phpstan analyse --memory-limit=1G",
        "test:cs": "PHP_CS_FIXER_IGNORE_ENV=1 php vendor/bin/php-cs-fixer fix --dry-run --diff .",
        "test:cs-fix": "PHP_CS_FIXER_IGNORE_ENV=1 php vendor/bin/php-cs-fixer fix .",
        "test:unit": "phpunit",
        "test": [
            "@test:cs",
            "@test:stan",
            "@test:unit"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        },
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/josecarlosnieto91/convoca-publisher/issues",
        "source": "https://github.com/josecarlosnieto91/convoca-publisher"
    }
}
