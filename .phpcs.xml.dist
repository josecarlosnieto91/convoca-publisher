<?xml version="1.0"?>
<ruleset name="Convoca">
  <description>WordPress Coding Standards for Convoca plugins</description>

  <file>.</file>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/tests/*</exclude-pattern>
  <exclude-pattern>dev-tools/*</exclude-pattern>
  <exclude-pattern>*/build-dir/*</exclude-pattern>
  <exclude-pattern>phpstan-bootstrap.php</exclude-pattern>
  <exclude-pattern>phpstan-stubs/*</exclude-pattern>

  <arg name="extensions" value="php"/>
  <arg value="sp"/>

  <rule ref="WordPress">
    <!--
      Exclusiones con motivo escrito, iguales que en el resto del ecosistema. No es un
      silenciador: el estandar declara que acepta y por que, y queda versionado en el repo.
    -->
    <exclude name="WordPress.Files.FileName"/>
    <exclude name="WordPress.NamingConventions"/>
    <exclude name="WordPress.WP.I18n.NoHtmlWrappedStrings"/>
    <exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode"/>
    <exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_decode"/>
    <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_file_put_contents"/>
    <exclude name="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents"/>
    <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_mkdir"/>
    <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_touch"/>
    <exclude name="WordPress.NamingConventions.ValidHookName.UseUnderscores"/>
    <exclude name="WordPress.WP.PostsPerPage.posts_per_page_posts_per_page"/>
    <exclude name="WordPress.DB.PreparedSQLPlaceholders.UnfinishedPrepare"/>
    <exclude name="WordPress.DB.PreparedSQLPlaceholders.ReplacementsWrongNumber"/>
    <exclude name="WordPress.WP.CronInterval.CronSchedulesInterval"/>
    <exclude name="Generic.CodeAnalysis.AssignmentInCondition"/>
    <exclude name="WordPress.PHP.DevelopmentFunctions.error_log_error_log"/>
  </rule>

  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="convoca"/>
        <element value="convoca-core"/>
        <element value="convoca-publisher"/>
      </property>
    </properties>
  </rule>
<!--
    1. DirectDatabaseQuery: los plugins consultan TABLAS PROPIAS (cola de publicacion,
       reintentos, historico) para las que WP no ofrece API. NoCaching tampoco aplica: son
       datos por-usuario y por-peticion. Mismo motivo escrito y versionado que en
       convoca-core y convoca-members.
    2. PreparedSQL: prepare() acepta un array como segundo argumento desde WP 4.9, y PHPCS
       no ve los marcadores de una variable interpolada ($where_clause, $placeholders).
  -->
  <rule ref="WordPress.DB.DirectDatabaseQuery">
    <exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
    <exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
    <exclude name="WordPress.DB.DirectDatabaseQuery.SchemaChange"/>
  </rule>
</ruleset>

