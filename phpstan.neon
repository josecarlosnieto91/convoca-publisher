includes:
	- phpstan-baseline.neon

parameters:
	level: 5
	reportUnmatchedIgnoredErrors: false
	paths:
		- includes
		- convoca-publisher.php
		- uninstall.php
	excludePaths:
		analyseAndScan:
			- vendor
			- tests
			- dev-tools
			- node_modules (?)
	scanFiles:
		- stubs/constants.stub
		- stubs/wp-cli.stub
	bootstrapFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
		- phpstan-bootstrap.php
