# includes:
#     - phpstan-baseline.neon (comentado durante limpieza de deuda)

parameters:
	level: 5
	reportUnmatchedIgnoredErrors: false
	paths:
		- includes
		- convoca-publisher.php
		- uninstall.php
	excludePaths:
		analyseAndScan:
			- vendor
			- tests
			- dev-tools
			- node_modules (?)
	scanFiles:
		- stubs/constants.stub
		- stubs/wp-cli.stub
	bootstrapFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
		- phpstan-bootstrap.php
	ignoreErrors:
		# ── Falsos positivos del harness de análisis (NO deuda de código) ──
		# El stub de WP_Error no declara get_error_message() en este contexto;
		# los canales llaman al método real de WP_Error en runtime.
		-
			message: '#Call to an undefined method WP_Error::get_error_message#'
			identifier: method.notFound
		# version_compare con el PHP del analizador (8.4) hace el chequeo de
		# requisitos siempre false AQUÍ, pero protege instalaciones con PHP
		# antiguo en producción — el guard es correcto en runtime.
		-
			message: '#If condition is always false#'
			identifier: if.alwaysFalse
			path: convoca-publisher.php
		# register_deactivation_hook acepta string 'Clase::metodo'.
		-
			message: '#Parameter \#2 \$callback of function register_deactivation_hook#'
			identifier: argument.type
		# require_once de wp-admin en análisis aislado (ABSPATH=/tmp/wp/).
		-
			message: '#Path in require_once\(\) "/tmp/wp/#'
			identifier: requireOnce.fileNotFound
